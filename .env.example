# MySQL (use a read-only account)
ANNOTATION_MYSQL_HOST=127.0.0.1
ANNOTATION_MYSQL_PORT=3306
ANNOTATION_MYSQL_USER=annotation_reader
ANNOTATION_MYSQL_DATABASE=annotation_db
ANNOTATION_DB_PASSWORD=replace_me

# Optional SSH tunnel; key-based SSH authentication is recommended
ANNOTATION_USE_SSH_TUNNEL=0
ANNOTATION_SSH_HOST=db.example.com
ANNOTATION_SSH_USER=deploy
ANNOTATION_SSH_MYSQL_PORT=3306
ANNOTATION_LOCAL_MYSQL_PORT=44060

# Feishu/Lark Base IDs. Never commit real values.
ANNOTATION_BASE_TOKEN=replace_me
ANNOTATION_DAILY_TABLE_ID=replace_me
ANNOTATION_STAFF_TABLE_ID=replace_me
ANNOTATION_PROJECT_TABLE_ID=replace_me
ANNOTATION_METRICS_TABLE_ID=replace_me
ANNOTATION_TASK_NAMES_JSON=["商品图片分类","道路目标框选","客服文本实体标注","会议音频转写","短视频片段切分","多模态结果质检"]
# Optional: set this only when one task measures progress by unique-object coverage.
ANNOTATION_COVERAGE_TASK_NAME=
ANNOTATION_RECORD_MAP_JSON={"trail":"record_trail","fallDetect_school":"record_fall_school","fallDetect_external":"record_fall_external","climbDetect":"record_climb","smokeAlarm":"record_smoke","calling":"record_calling","strongExercise":"record_exercise"}

# Feishu custom-bot webhooks. macOS Keychain is also supported; see README.
ANNOTATION_DETAIL_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_me
ANNOTATION_FORMAL_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_me
ANNOTATION_WEEKLY_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_me
LARK_TENANT_DOMAIN=feishu.cn
